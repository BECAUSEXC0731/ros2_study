<?xml version="1.0" ?>
<robot name="simple_car">

  <!-- ==================== 虚拟根链接 ==================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_chassis" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
    <origin xyz="0 0 0.095"/>
  </joint>

  <!-- ==================== 底盘 ==================== -->
  <link name="chassis">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.6 0.3 0.15"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.6 0.3 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.13125" ixy="0.0" ixz="0.0" iyy="0.36667" iyz="0.0" izz="0.49792"/>
    </inertial>
  </link>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00000067" ixy="0.0" ixz="0.0" iyy="0.00000067" iyz="0.0" izz="0.00000067"/>
    </inertial>
  </link>
  <joint name="chassis_to_imu" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0.15 0 0.1"/>
  </joint>

  <!-- ==================== 后左轮（驱动轮） ==================== -->
  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.25 -0.175 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_left_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="rear_left_contact_joint" type="fixed">
    <parent link="rear_left_wheel"/>
    <child link="rear_left_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 后右轮（驱动轮） ==================== -->
  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.25 0.175 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rear_right_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="rear_right_contact_joint" type="fixed">
    <parent link="rear_right_wheel"/>
    <child link="rear_right_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 前左轮（从动万向轮） ==================== -->
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0016"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.25 -0.175 -0.08"/>
  </joint>
  <link name="front_left_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="front_left_contact_joint" type="fixed">
    <parent link="front_left_wheel"/>
    <child link="front_left_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 前右轮（从动万向轮） ==================== -->
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0016"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.25 0.175 -0.08"/>
  </joint>
  <link name="front_right_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="front_right_contact_joint" type="fixed">
    <parent link="front_right_wheel"/>
    <child link="front_right_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 激光雷达 ==================== -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00104" iyz="0.0" izz="0.000625"/>
    </inertial>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.18"/>
  </joint>

  <!-- ==================== 深度相机 ==================== -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000354" ixy="0.0" ixz="0.0" iyy="0.0000354" iyz="0.0" izz="0.0000667"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.1"/>
  </joint>

  <!-- ==================== Gazebo 材质与摩擦力 ==================== -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ⚠️ 修复：万向轮摩擦改为0，避免物理约束冲突导致仿真卡死 -->
  <gazebo reference="front_left_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="rear_left_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="rear_right_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ⚠️ 修复：万向轮接触点摩擦也改为0 -->
  <gazebo reference="front_left_contact">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="front_right_contact">
    <mu1>0.0</mu1><mu2>0.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ==================== 差速驱动插件（已修复） ==================== -->
  <gazebo>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <!-- ⚠️ 新增：显式ROS2配置，确保节点正确初始化 -->
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <update_rate>100.0</update_rate>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- ⚠️ 新增：显式启用里程计发布 -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.001</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- ==================== 激光雷达传感器插件 (ROS2) ==================== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== 深度相机传感器插件 (ROS2) ==================== -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="gazebo_ros_depth_camera" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>~/image_raw:=/camera/color/image_raw</remapping>
          <remapping>~/depth/image_raw:=/camera/depth/image_raw</remapping>
          <remapping>~/points:=/camera/depth/points</remapping>
          <remapping>~/camera_info:=/camera/camera_info</remapping>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_link</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

</robot>