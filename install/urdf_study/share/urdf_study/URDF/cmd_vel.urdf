<?xml version="1.0" ?>
<robot name="simple_car">

  <!-- ==================== 虚拟根链接 ==================== -->
  <link name="base_footprint"/>
  <joint name="base_footprint_to_chassis" type="fixed">
    <parent link="base_footprint"/>
    <child link="chassis"/>
    <!-- 【修复1】增加安全间隙，防止初始时刻轮子/接触球与地面穿透导致弹飞 -->
    <origin xyz="0 0 0.095"/>
  </joint>

  <!-- ==================== 底盘 ==================== -->
  <link name="chassis">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.6 0.3 0.15"/></geometry>
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.6 0.3 0.15"/></geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.13125" ixy="0.0" ixz="0.0" iyy="0.36667" iyz="0.0" izz="0.49792"/>
    </inertial>
  </link>

  <!-- ==================== IMU ==================== -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.02 0.02 0.02"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00000067" ixy="0.0" ixz="0.0" iyy="0.00000067" iyz="0.0" izz="0.00000067"/>
    </inertial>
  </link>
  <joint name="chassis_to_imu" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0.15 0 0.1"/>
  </joint>

  <!-- ==================== 前轮转向悬挂 ==================== -->
  <link name="front_left_hinge">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_left_steering" type="revolute">
    <parent link="chassis"/>
    <child link="front_left_hinge"/>
    <origin xyz="0.25 -0.175 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="front_right_hinge">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_right_steering" type="revolute">
    <parent link="chassis"/>
    <child link="front_right_hinge"/>
    <origin xyz="0.25 0.175 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- ==================== 后左轮 ==================== -->
  <link name="rear_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.25 -0.175 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="rear_left_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="rear_left_contact_joint" type="fixed">
    <parent link="rear_left_wheel"/>
    <child link="rear_left_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 后右轮 ==================== -->
  <link name="rear_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.25 0.175 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="rear_right_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="rear_right_contact_joint" type="fixed">
    <parent link="rear_right_wheel"/>
    <child link="rear_right_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 前左轮 ==================== -->
  <link name="front_left_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_rotation" type="continuous">
    <parent link="front_left_hinge"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="front_left_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="front_left_contact_joint" type="fixed">
    <parent link="front_left_wheel"/>
    <child link="front_left_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 前右轮 ==================== -->
  <link name="front_right_wheel">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
      <material name="gray"><color rgba="0.3 0.3 0.3 1"/></material>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.08"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.00427" ixy="0.0" ixz="0.0" iyy="0.00427" iyz="0.0" izz="0.0032"/>
    </inertial>
  </link>
  <joint name="front_right_wheel_rotation" type="continuous">
    <parent link="front_right_hinge"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 -0.08"/>
    <axis xyz="0 1 0"/>
  </joint>
  
  <link name="front_right_contact">
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><sphere radius="0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000000004" ixy="0.0" ixz="0.0" iyy="0.0000000004" iyz="0.0" izz="0.0000000004"/>
    </inertial>
  </link>
  <joint name="front_right_contact_joint" type="fixed">
    <parent link="front_right_wheel"/>
    <child link="front_right_contact"/>
    <origin xyz="0 0 -0.08"/>
  </joint>

  <!-- ==================== 激光雷达 ==================== -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00104" ixy="0.0" ixz="0.0" iyy="0.00104" iyz="0.0" izz="0.000625"/>
    </inertial>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.18"/>
  </joint>

  <!-- ==================== 相机 ==================== -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
      <material name="green"><color rgba="0 1 0 1"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="0.05 0.05 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0000354" ixy="0.0" ixz="0.0" iyy="0.0000354" iyz="0.0" izz="0.0000667"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.1"/>
  </joint>

  <!-- ==================== Gazebo 材质与摩擦力 ==================== -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 车轮圆柱体摩擦力 -->
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- 【修复2】接触点球必须设置摩擦力，否则实际触地点打滑导致键盘控制无效 -->
  <gazebo reference="rear_left_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="rear_right_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="front_left_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="front_right_contact">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ==================== Ackermann 驱动插件 + 物理引擎优化 ==================== -->
  <gazebo>
    <!-- 【修复3】降低物理步长，提高求解器稳定性，彻底解决初始乱动 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <update_rate>100.0</update_rate>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <front_left_steering_joint>front_left_steering</front_left_steering_joint>
      <front_right_steering_joint>front_right_steering</front_right_steering_joint>
      <rear_left_wheel_joint>rear_left_wheel_joint</rear_left_wheel_joint>
      <rear_right_wheel_joint>rear_right_wheel_joint</rear_right_wheel_joint>

      <wheel_separation>0.35</wheel_separation>
      <wheel_diameter>0.16</wheel_diameter>
      <max_steer_angle>0.6</max_steer_angle>
      <max_speed>2.0</max_speed>

      <steering_p>10.0</steering_p>
      <steering_i>0.0</steering_i>
      <steering_d>0.5</steering_d>
    </plugin>
  </gazebo>

</robot>