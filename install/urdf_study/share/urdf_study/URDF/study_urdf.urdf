<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simple_car">

  <!-- 参数定义 -->
  <xacro:property name="M_PI" value="3.1415926535897931" />
  
  <!-- 车身参数 -->
  <xacro:property name="chassis_length" value="0.6" />
  <xacro:property name="chassis_width" value="0.3" />
  <xacro:property name="chassis_height" value="0.15" />
  <xacro:property name="chassis_mass" value="10.0" />

  <!-- 车轮参数 -->
  <xacro:property name="wheel_radius" value="0.08" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_mass" value="1.0" />
  <xacro:property name="wheel_offset_x" value="0.25" />
  <xacro:property name="wheel_offset_y" value="0.175" />
  <xacro:property name="wheel_z_offset" value="-0.08" />

  <!-- 传感器参数 -->
  <xacro:property name="imu_size" value="0.02" />
  <xacro:property name="lidar_radius" value="0.05" />
  <xacro:property name="lidar_height" value="0.05" />
  <xacro:property name="camera_size_x" value="0.05" />
  <xacro:property name="camera_size_y" value="0.05" />
  <xacro:property name="camera_size_z" value="0.03" />

  <!-- 惯性计算宏 -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertia ixx="${m*(h*h+d*d)/12}" ixy="0.0" ixz="0.0"
             iyy="${m*(w*w+d*d)/12}" iyz="0.0"
             izz="${m*(w*w+h*h)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0.0" ixz="0.0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0.0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
             iyy="${2*m*r*r/5}" iyz="0.0"
             izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <!-- 底盘 -->
  <link name="chassis">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" w="${chassis_width}" h="${chassis_height}" d="${chassis_length}"/>
    </inertial>
  </link>

  <!-- 惯性测量单元 (IMU) 示例 -->
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${imu_size} ${imu_size} ${imu_size}"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <xacro:box_inertia m="0.01" w="${imu_size}" h="${imu_size}" d="${imu_size}"/>
    </inertial>
  </link>
  <joint name="chassis_to_imu" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0.15 0 0.1"/>
  </joint>

  <!-- 前轮悬挂点 -->
  <link name="front_left_hinge">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_left_steering" type="revolute">
    <parent link="chassis"/>
    <child link="front_left_hinge"/>
    <origin xyz="${wheel_offset_x} -${wheel_offset_y} 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="front_right_hinge">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="front_right_steering" type="revolute">
    <parent link="chassis"/>
    <child link="front_right_hinge"/>
    <origin xyz="${wheel_offset_x} ${wheel_offset_y} 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- 车轮宏 -->
  <xacro:macro name="wheel" params="prefix parent suffix reflect">
    <!-- 车轮 -->
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="${M_PI/2} 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
        <material name="gray">
          <color rgba="0.3 0.3 0.3 1"/>
        </material>
      </visual>
      <collision>
        <origin rpy="${M_PI/2} 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${suffix} -${reflect*wheel_offset_y} ${wheel_z_offset}"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- 车轮接触点 -->
    <link name="${prefix}_contact">
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="0.01"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.001"/>
        <xacro:sphere_inertia m="0.001" r="0.01"/>
      </inertial>
    </link>
    <joint name="${prefix}_contact_joint" type="fixed">
      <parent link="${prefix}_wheel"/>
      <child link="${prefix}_contact"/>
      <origin xyz="0 0 ${wheel_z_offset}"/>
    </joint>
  </xacro:macro>

  <!-- 使用宏创建车轮 -->
  <xacro:wheel prefix="rear_left" parent="chassis" suffix="-${wheel_offset_x}" reflect="1"/>
  <xacro:wheel prefix="rear_right" parent="chassis" suffix="-${wheel_offset_x}" reflect="-1"/>
  <xacro:wheel prefix="front_left" parent="front_left_hinge" suffix="0" reflect="1"/>
  <xacro:wheel prefix="front_right" parent="front_right_hinge" suffix="0" reflect="-1"/>

  <!-- 激光雷达 -->
  <link name="lidar_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="${lidar_radius}"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="${lidar_height}" radius="${lidar_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <xacro:cylinder_inertia m="0.5" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.18"/>
  </joint>

  <!-- 相机 -->
  <link name="camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:box_inertia m="0.1" w="${camera_size_x}" h="${camera_size_y}" d="${camera_size_z}"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.1"/>
    <axis xyz="0 0 1"/>
  </joint>

</robot>